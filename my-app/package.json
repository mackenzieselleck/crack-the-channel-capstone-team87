{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:daily": "vitest run --project unit lib/daily-challenge lib/supabase/dailyChallenge.test.ts components/daily-challenge app/api/challenge",
    "test:daily:report": "cross-env VITEST_REPORT=1 vitest run --project unit lib/daily-challenge lib/supabase/dailyChallenge.test.ts components/daily-challenge app/api/challenge",
    "test:daily:e2e": "playwright test dailyChallenge --workers=2",
    "test:unit": "vitest run --project unit",
    "test:badges": "vitest run --project unit components/badges",
    "db:start": "supabase db start",
    "db:stop": "supabase stop",
    "test:db": "supabase test db",
    "test:watch": "vitest",
    "test:report": "cross-env VITEST_REPORT=1 vitest run",
    "test:coverage": "cross-env VITEST_REPORT=1 vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report reports/e2e/html"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.1",
    "@rive-app/react-canvas": "^4.37.1",
    "@rive-app/react-webgl2": "^4.34.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "katex": "^0.19.0",
    "lucide-react": "^1.45.0",
    "next": "^16.4.0",
    "openai": "^7.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "fast-glob": "^3.3.3",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
